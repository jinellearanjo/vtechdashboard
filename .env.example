# Copy this file to .env.local (never commit .env.local) and fill in the values.
# Vite only exposes variables that start with VITE_ to the browser, and everything below ends up in the built site,
# so only put PUBLIC values here. The Supabase anon/publishable key is designed to be public; Row Level Security
# protects the data. NEVER put a service-role key here.

# Supabase project URL and anon (publishable) key: Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional. Old legacy accounts (created before passwords were required) can still sign in once from the browser
# that remembers them, then set a password. Set to "false" when everyone has done that.
# VITE_ALLOW_DEVICE_LOGIN=false
