# Template for the Google Drive secrets used by the push-to-drive Edge Function.
# Copy to supabase/.env.drive (ignored by git), fill it in, then run:
#   supabase secrets set --env-file supabase/.env.drive
#   (delete the file afterwards)
# Full walkthrough: docs/DRIVE_SETUP.md

# Google Drive folder IDs (the last part of a folder's URL)
DRIVE_SUBMISSIONS_FOLDER_ID=
DRIVE_MARKETING_FOLDER_ID=
DRIVE_LEGAL_FOLDER_ID=
DRIVE_TECHNICAL_FOLDER_ID=
DRIVE_SALES_FOLDER_ID=
DRIVE_AUTOMATIONS_FOLDER_ID=
DRIVE_FINANCE_FOLDER_ID=
DRIVE_LEAD_GEN_FOLDER_ID=

# Path B (personal Gmail): the Apps Script web app URL (ends in /exec) and the secret you stored as SECRET in the script
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# Path A only (Workspace + Shared Drive): the whole service-account JSON on ONE line, in single quotes
# GOOGLE_SERVICE_ACCOUNT='{"type":"service_account", ...}'

# Path C only (OAuth, needs a domain you own)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# Optional: restrict CORS for the Edge Functions to your site
# ALLOWED_ORIGIN=https://your-site.vercel.app
